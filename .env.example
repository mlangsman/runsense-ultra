# Names only. Values live in Vercel's environment settings; pull them locally with `npx vercel env pull .env.local`.
INTERVALS_ICU_API_KEY=
INTERVALS_ICU_ATHLETE_ID=
# Fixtures for tests come from `node scripts/capture-fixture.mjs <activity id>`, run locally with the key above.
# Optional in local development: a public HTTPS tunnel URL so widgets load inside the MCP host.
BASE_URL=
# Map tiles in the workout widget. A free key from https://carto.com/basemaps/apikey (no account needed);
# CARTO has required one since 25 Sep 2026. Public by design (it is in tile URLs); without it the route draws on a plain card.
NEXT_PUBLIC_CARTO_API_KEY=
# Route maps as Apple Maps Web Snapshots: an Apple Developer team, a key with MapKit JS enabled, and the key's .p8 contents
# (the PEM on one line with \n for newlines is fine). The key never leaves the server; the tool result carries signed image URLs.
# Without all three the widget falls back to CARTO tiles, then to its own vector route.
APPLE_MAPS_TEAM_ID=
APPLE_MAPS_KEY_ID=
APPLE_MAPS_PRIVATE_KEY=
