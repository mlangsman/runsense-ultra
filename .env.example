# Names only. Values live in Vercel's environment settings; pull them locally with `npx vercel env pull .env.local`.
INTERVALS_ICU_API_KEY=
INTERVALS_ICU_ATHLETE_ID=
# Fixtures for tests come from `node scripts/capture-fixture.mjs <activity id>`, run locally with the key above.
# Optional in local development: a public HTTPS tunnel URL so widgets load inside the MCP host.
BASE_URL=
# Map tiles in the workout widget: any OpenStreetMap-style raster provider as a URL template with {z}/{x}/{y} and
# optionally {r} for 2x tiles. Keys travel in the template and are public by design (they are in tile URLs).
# Closest to an outdoors app's map: Thunderforest Outdoors, free hobby key from https://www.thunderforest.com/pricing/
#   https://tile.thunderforest.com/outdoors/{z}/{x}/{y}{r}.png?apikey=<key>   with attribution "Maps © Thunderforest, Data © OpenStreetMap contributors"
# The dark template is optional; without it the light tiles show in both themes.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_URL_DARK=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Fallback when no template is set: CARTO's basemaps (Voyager light, Dark Matter dark) with a free key from
# https://carto.com/basemaps/apikey (no account needed). With neither, the route draws on a plain card.
NEXT_PUBLIC_CARTO_API_KEY=
